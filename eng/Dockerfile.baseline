FROM mcr.microsoft.com/dotnet/sdk:10.0.400@sha256:e1fc6e423f543119c406d24e2e687d67c569f18f04a37a8b0005d80ad0dcee80

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Rubjerg.Graphviz ships its own Graphviz binaries but the Linux x64 bundle
# dynamically links libltdl. libgdiplus is present only to make the next
# System.Drawing compatibility boundary explicit during baseline generation.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgdiplus libltdl7 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
